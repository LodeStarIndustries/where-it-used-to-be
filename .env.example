# Copy to .env.local for local development and fill in from your DEV Supabase project.
# Never put production keys in .env.local. See SETUP.md for where each value comes from.

# --- App (also set these in Vercel: Preview = dev project, Production = prod project) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-DEV-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Local scripts only (npm run db:*). Not needed in Vercel. ---
SUPABASE_DEV_PROJECT_REF=your-dev-ref
SUPABASE_PROD_PROJECT_REF=your-prod-ref

# Supabase CLI sign-in, used instead of `npx supabase login`.
# Create at https://supabase.com/dashboard/account/tokens (name it "where-it-used-to-be cli").
SUPABASE_ACCESS_TOKEN=
# The DEV project's database password (the one you saved when creating it).
# The production password is never stored: npm run db:push:prod asks for it.
SUPABASE_DEV_DB_PASSWORD=
